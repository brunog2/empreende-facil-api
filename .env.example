# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=empreende_facil

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Application Configuration
NODE_ENV=development
PORT=3000

# Optional administrator bootstrap
# Configure strong credentials outside development.
ADMIN_EMAIL=adm@adm.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=Administrador

# Payment provider adapter
# "mock" creates pending payments and never confirms them from the browser.
PAYMENT_PROVIDER=mock
# Required only to validate local mock webhook signatures.
MOCK_PAYMENT_WEBHOOK_SECRET=change-this-local-webhook-secret

# Automatic backups kept in PostgreSQL (days)
BACKUP_RETENTION_DAYS=90
